<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NativeDll>..\..\native\build\bin\patchcore_native.dll</NativeDll>
    <CoreNativeDll>..\PatchCoreNg.Core\bin\$(Configuration)\net8.0\patchcore_native.dll</CoreNativeDll>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PatchCoreNg.Core\PatchCoreNg.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyNativeDll" AfterTargets="Build">
    <PropertyGroup>
      <NativeSource Condition="Exists('$(CoreNativeDll)')">$(CoreNativeDll)</NativeSource>
      <NativeSource Condition="'$(NativeSource)' == '' and Exists('$(NativeDll)')">$(NativeDll)</NativeSource>
    </PropertyGroup>
    <Copy SourceFiles="$(NativeSource)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'$(NativeSource)' != ''" />
  </Target>

</Project>
